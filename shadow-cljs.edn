{:source-paths ["src" "test" "resources"]
 :dependencies []
 :dev-http {8080 {:root "public" :host "localhost"   ; this Mac only
                  ;; /state/* (real state, crew prompts, the bridge token) comes from state/, same-origin
                  ;; only, via pm.dev-http: shadow sends Access-Control-Allow-Origin: * on public/.
                  :handler pm.dev-http/handle}}
 :builds
 {:app {:target :browser
        :output-dir "public/js"
        :asset-path "/js"
        :modules {:main {:init-fn pm.core/init!}}
        :devtools {:after-load pm.core/reload!
                   ;; no warning/error box over the game: the crew edits live in this checkout,
                   ;; so half-finished saves would flash it at Michael. The watcher terminal and
                   ;; the gate (0 warnings) still catch everything.
                   :hud false}}
  ;; Unit tests for the pure namespaces (pm.world, ...): *-test namespaces under test/.
  :test {:target    :node-test
         :output-to "out/test.js"
         :ns-regexp "-test$"
         :autorun   false}}}

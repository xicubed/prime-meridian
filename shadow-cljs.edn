{:source-paths ["src" "test" "resources"]
 :dependencies []
 :dev-http {8080 "public"}
 :builds
 {:app {:target :browser
        :output-dir "public/js"
        :asset-path "/js"
        :modules {:main {:init-fn pm.core/init!}}
        :devtools {:after-load pm.core/reload!}}
  ;; Unit tests for the pure namespaces (pm.world, ...): *-test namespaces under test/.
  :test {:target    :node-test
         :output-to "out/test.js"
         :ns-regexp "-test$"
         :autorun   false}}}

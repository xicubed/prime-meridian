{
  "name": "prime-meridian",
  "version": "0.1.0",
  "private": true,
  "description": "A cozy 3D management game where the characters are real AI agents.",
  "scripts": {
    "dev": "shadow-cljs watch app",
    "build": "shadow-cljs release app",
    "serve": "bb serve",
    "postinstall": "node -e \"const fs=require('fs');const s='node_modules/@mujoco/mujoco/',t='public/vendor/mujoco/';fs.mkdirSync(t,{recursive:true});for(const f of ['mujoco.js','mujoco.wasm'])fs.copyFileSync(s+f,t+f)\""
  },
  "devDependencies": {
    "shadow-cljs": "^2.28.0"
  },
  "dependencies": {
    "@mujoco/mujoco": "4.0.0",
    "three": "^0.186.1"
  }
}

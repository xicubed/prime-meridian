{
  "name": "prime-meridian",
  "version": "0.1.0",
  "private": true,
  "description": "A cozy 3D management game where the characters are real AI agents.",
  "scripts": {
    "dev": "shadow-cljs watch app",
    "build": "shadow-cljs release app",
    "serve": "bb serve",
    "postinstall": "node -e \"const fs=require('fs');const cp=(s,t,fs_)=>{fs.mkdirSync(t,{recursive:true});for(const f of fs_)fs.copyFileSync(s+f,t+f)};cp('node_modules/@mujoco/mujoco/','public/vendor/mujoco/',['mujoco.js','mujoco.wasm']);cp('node_modules/onnxruntime-web/dist/','public/vendor/onnxruntime/',['ort.wasm.min.mjs','ort-wasm-simd-threaded.mjs','ort-wasm-simd-threaded.wasm'])\""
  },
  "devDependencies": {
    "shadow-cljs": "^2.28.0"
  },
  "dependencies": {
    "@mujoco/mujoco": "4.0.0",
    "onnxruntime-web": "1.31.1",
    "three": "^0.186.1"
  }
}

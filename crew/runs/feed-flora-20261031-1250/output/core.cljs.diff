+(defn on-key! [^js e]
+  (when-not (or (.-repeat e) (.-ctrlKey e) (.-metaKey e) (.-altKey e))
+    (when-let [ev (world/key-event @!world (.-key e) (js/Date.now))]
+      (swap! !world world/chore-done ev)

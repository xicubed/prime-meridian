      "name": "hal",
      "title": "Hal",
      "role": "manager",
      "kind": "hermes",
      "backend": "anthropic",
      "model": "claude-opus-5-5",
      "external": true,
      "enabled": true,
      "note": "Hal, the Hero: Hermes in its desktop app, Michael's chat. Drives the crew with herdr from outside a pane."
